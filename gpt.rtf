\par
        \f2\ltrch\lang9 if (token != null)\f1\rtlch\lang1037\par
        \{\par
            \f2\ltrch\lang9 var principal = ValidateToken(token)\f1\rtlch\lang1037 ;\par
            \f2\ltrch\lang9 if (principal != null)\f1\rtlch\lang1037\par
            \{\par
                \f2\ltrch\lang9 context.User = principal\f1\rtlch\lang1037 ;\par
            \}\par
        \}\par
\par
        \f2\ltrch\lang9 await _next(context)\f1\rtlch\lang1037 ;\par
    \}\par
\par
    \f2\ltrch\lang9 private ClaimsPrincipal ValidateToken(string token)\f1\rtlch\lang1037\par
    \{\par
        \f2\ltrch\lang9 var key = new SymmetricSecurityKey(Encoding.UTF8.GetBytes(_configuration["Jwt:SecretKey"]))\f1\rtlch\lang1037 ;\par
        \f2\ltrch\lang9 var handler = new JwtSecurityTokenHandler\f1\rtlch\lang1037 ();\par
        \f2\ltrch\lang9 try\f1\rtlch\lang1037\par
        \{\par
