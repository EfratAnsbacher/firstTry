\}\par
```\par
\par
#### \f0\ltrch\lang1033 b) **Gift List Component\f1\rtlch\lang1037 **\par
\par
\f0\ltrch\lang1033 This component will display the list of gifts, and customers can view the gift details and add them to their cart\f1\rtlch\lang1037 .\par
\par
```\f0\ltrch\lang1033 typescript\f1\rtlch\lang1037\par
\f0\ltrch\lang1033 import \{ Component, OnInit \} from '@angular/core\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ GiftService \} from './gift.service\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ Gift \} from './models/gift.model\f1\rtlch\lang1037 ';\par
\par
@\f0\ltrch\lang1033 Component\f1\rtlch\lang1037 (\{\par
  \f0\ltrch\lang1033 selector: 'app-gift-list\f1\rtlch\lang1037 ',\par
  \f0\ltrch\lang1033 templateUrl: './gift-list.component.html\f1\rtlch\lang1037 ',\par
  \f0\ltrch\lang1033 styleUrls: ['./gift-list.component.css']\f1\rtlch\lang1037\par
\})\par
\f0\ltrch\lang1033 export class GiftListComponent implements OnInit\f1\rtlch\lang1037  \{\par
  \f0\ltrch\lang1033 gifts: Gift\f1\rtlch\lang1037 [] = [];\par
\par
  \f0\ltrch\lang1033 constructor(private giftService: GiftService)\f1\rtlch\lang1037  \{\}\par
\par
  \f0\ltrch\lang1033 ngOnInit(): void\f1\rtlch\lang1037  \{\par
    \f0\ltrch\lang1033 this.giftService.getGifts().subscribe((data: Gift\f1\rtlch\lang1037 []) => \{\par
      \f0\ltrch\lang1033 this.gifts = data\f1\rtlch\lang1037 ;\par
    \});\par
  \}\par
\par
  \f0\ltrch\lang1033 addToCart(gift: Gift): void\f1\rtlch\lang1037  \{\par
    // \f0\ltrch\lang1033 Logic to add gift to the shopping cart\f1\rtlch\lang1037\par
  \}\par
\}\par
```\par
\par
#### \f0\ltrch\lang1033 c) **Gift Service (Angular\f1\rtlch\lang1037 )**\par
\par
\f0\ltrch\lang1033 The service handles the API calls to fetch gifts and post purchases\f1\rtlch\lang1037 .\par
\par
```\f0\ltrch\lang1033 typescript\f1\rtlch\lang1037\par
\f0\ltrch\lang1033 import \{ Injectable \} from '@angular/core\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ HttpClient \} from '@angular/common/http\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ Observable \} from 'rxjs\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ Gift \} from './models/gift.model\f1\rtlch\lang1037 ';\par
\par
@\f0\ltrch\lang1033 Injectable\f1\rtlch\lang1037 (\{\par
  \f0\ltrch\lang1033 providedIn: 'root\f1\rtlch\lang1037 '\par
\})\par
\f0\ltrch\lang1033 export class GiftService\f1\rtlch\lang1037  \{\par
  \f0\ltrch\lang1033 private apiUrl = '{{\field{\*\fldinst{HYPERLINK https://your-api-url/api/gifts }}{\fldrslt{https://your-api-url/api/gifts\ul0\cf0}}}}\f1\rtlch\fs22\lang1037 ';\par
\par
  \f0\ltrch\lang1033 constructor(private http: HttpClient)\f1\rtlch\lang1037  \{\}\par
\par
  \f0\ltrch\lang1033 getGifts(): Observable<Gift\f1\rtlch\lang1037 []> \{\par
    \f0\ltrch\lang1033 return this.http.get<Gift[]>(this.apiUrl)\f1\rtlch\lang1037 ;\par
  \}\par
\par
  \f0\ltrch\lang1033 makePurchase(giftId: number, customerId: number): Observable<any\f1\rtlch\lang1037 > \{\par
    \f0\ltrch\lang1033 return this.http.post<any>(`$\{this.apiUrl\}/purchase`, \{ giftId, customerId \})\f1\rtlch\lang1037 ;\par
  \}\par
\}\par
```\par
\par
#### \f0\ltrch\lang1033 d) **Angular Routing (For Managing Pages\f1\rtlch\lang1037 )**\par
\par
\f0\ltrch\lang1033 You will want routes to handle the login, gift display, and other necessary pages\f1\rtlch\lang1037 .\par
\par
```\f0\ltrch\lang1033 typescript\f1\rtlch\lang1037\par
\f0\ltrch\lang1033 const routes: Routes\f1\rtlch\lang1037  = [\par
  \{ \f0\ltrch\lang1033 path: '', component: GiftListComponent\f1\rtlch\lang1037  \},\par
  \{ \f0\ltrch\lang1033 path: 'login', component: LoginComponent\f1\rtlch\lang1037  \},\par
  \{ \f0\ltrch\lang1033 path: 'admin', component: AdminDashboardComponent, canActivate: [AuthGuard]\f1\rtlch\lang1037  \}\par
];\par
```\par
\par
### \f0\ltrch\lang1033 4\f1\rtlch\lang1037 . **\f0\ltrch\lang1033 Admin Dashboard for Lottery (Manager)\f1\rtlch\lang1037 **\par
\par
\f0\ltrch\lang1033 Once the manager logs in, they will be able to run the lottery and view the gift winners\f1\rtlch\lang1037 .\par
\par
#### \f0\ltrch\lang1033 a) **Admin Dashboard Component\f1\rtlch\lang1037 **\par
\par
```\f0\ltrch\lang1033 typescript\f1\rtlch\lang1037\par
@\f0\ltrch\lang1033 Component\f1\rtlch\lang1037 (\{\par
  \f0\ltrch\lang1033 selector: 'app-admin-dashboard\f1\rtlch\lang1037 ',\par
  \f0\ltrch\lang1033 templateUrl: './admin-dashboard.component.html\f1\rtlch\lang1037 ',\par
  \f0\ltrch\lang1033 styleUrls: ['./admin-dashboard.component.css']\f1\rtlch\lang1037\par
\})\par
\f0\ltrch\lang1033 export class AdminDashboardComponent implements OnInit\f1\rtlch\lang1037  \{\par
  \f0\ltrch\lang1033 lotteries: Lottery\f1\rtlch\lang1037 [] = [];\par
\par
  \f0\ltrch\lang1033 constructor(private lotteryService: LotteryService)\f1\rtlch\lang1037  \{\}\par
\par
  \f0\ltrch\lang1033 ngOnInit(): void\f1\rtlch\lang1037  \{\par
    \f0\ltrch\lang1033 this.lotteryService.getAllLotteries().subscribe((data: Lottery\f1\rtlch\lang1037 []) => \{\par
      \f0\ltrch\lang1033 this.lotteries = data\f1\rtlch\lang1037 ;\par
    \});\par
  \}\par
\par
  \f0\ltrch\lang1033 drawLottery(giftId: number): void\f1\rtlch\lang1037  \{\par
    \f0\ltrch\lang1033 this.lotteryService.drawLottery(giftId).subscribe((winner: string\f1\rtlch\lang1037 ) => \{\par
      \f0\ltrch\lang1033 alert(`Winner: $\{winner\}`)\f1\rtlch\lang1037 ;\par
      \f0\ltrch\lang1033 this.ngOnInit(); // Refresh the list\f1\rtlch\lang1037\par
    \});\par
  \}\par
\}\par
```\par
\par
#### \f0\ltrch\lang1033 b) **Lottery Service (Angular\f1\rtlch\lang1037 )**\par
\par
\f0\ltrch\lang1033 Service to handle lottery draws for the admin\f1\rtlch\lang1037 :\par
\par
```\f0\ltrch\lang1033 typescript\f1\rtlch\lang1037\par
\f0\ltrch\lang1033 import \{ Injectable \} from '@angular/core\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ HttpClient \} from '@angular/common/http\f1\rtlch\lang1037 ';\par
\f0\ltrch\lang1033 import \{ Observable \} from 'rxjs\f1\rtlch\lang1037 ';\par
\par
@\f0\ltrch\lang1033 Injectable\f1\rtlch\lang1037 (\{\par
  \f0\ltrch\lang1033 providedIn: 'root\f1\rtlch\lang1037 '\par
\})\par
\f0\ltrch\lang1033 export class LotteryService\f1\rtlch\lang1037  \{\par
  \f0\ltrch\lang1033 private apiUrl = '{{\field{\*\fldinst{HYPERLINK https://your-api-url/api/lottery }}{\fldrslt{https://your-api-url/api/lottery\ul0\cf0}}}}\f1\rtlch\fs22\lang1037 ';\par
\par
