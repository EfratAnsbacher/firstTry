            \f2\ltrch\lang9 var claims = jsonToken?.Claims\f1\rtlch\lang1037 ;\par
            \f2\ltrch\lang9 var principal = new ClaimsPrincipal(new ClaimsIdentity(claims))\f1\rtlch\lang1037 ;\par
            \f2\ltrch\lang9 return principal\f1\rtlch\lang1037 ;\par
